---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, useTranslatedPath } from '@/i18n/utils';

const lang = 'en';
const tp = useTranslatedPath(lang);
---

<BaseLayout title="Blog – RealInnovation" description="Thoughts on software architecture, business automation, and building products that matter." lang={lang}>

  <section class="relative pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase text-emerald-400 border border-emerald-500/20 bg-emerald-500/5 mb-6">
        {t(lang, 'blog.badge')}
      </span>
      <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight">
        {t(lang, 'blog.title')} <span class="gradient-text">{t(lang, 'blog.titleHighlight')}</span>
      </h1>
      <p class="text-lg text-neutral-300 max-w-2xl mx-auto">{t(lang, 'blog.subtitle')}</p>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="rounded-2xl p-12 bg-neutral-900/50 border border-white/5">
        <div class="text-5xl mb-6">📝</div>
        <p class="text-neutral-400 text-lg">{t(lang, 'blog.comingSoon')}</p>
      </div>
    </div>
  </section>

</BaseLayout>
