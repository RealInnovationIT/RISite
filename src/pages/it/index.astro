---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, useTranslatedPath } from '@/i18n/utils';
import { ConstellationNetwork } from '@/components/react/ConstellationNetwork';
import { FlipText } from '@/components/react/FlipText';
import { BorderBeam } from '@/components/react/BorderBeam';
import { CountUp } from '@/components/react/CountUp';

const lang = 'it';
const tp = useTranslatedPath(lang);
---

<BaseLayout title="RealInnovation – Soluzioni Software Intelligenti" lang={lang}>

  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-screen w-full flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-[#0a0a0f]" />
    <ConstellationNetwork client:load className="opacity-70" nodeCount={70} connectionDistance={140} />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,rgba(10,10,15,0.9)_100%)]" />

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-500/20 bg-emerald-500/5 backdrop-blur-sm mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-sm text-emerald-300 font-medium">{t(lang, 'hero.badge')}</span>
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white mb-2 leading-tight tracking-tight">
        {t(lang, 'hero.title')}
        <span class="gradient-text"> {t(lang, 'hero.titleHighlight')}</span>
      </h1>

      <div class="mb-8 h-16 md:h-20 flex items-center justify-center">
        <FlipText client:load className="text-3xl md:text-5xl font-black text-emerald-400" duration={3} text="INNOVARE INTEGRARE AUTOMATIZZARE" />
      </div>

      <p class="text-lg md:text-xl text-neutral-300 max-w-3xl mx-auto mb-10 leading-relaxed">
        {t(lang, 'hero.subtitle')}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={tp('/leaf')} class="btn-primary text-base px-8 py-4">
          {t(lang, 'hero.cta1')}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href={tp('/contact')} class="btn-secondary text-base px-8 py-4 border-white/10 text-white hover:border-emerald-400/50">
          {t(lang, 'hero.cta2')}
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== STATS BAR ===================== -->
  <section class="relative py-16 border-y border-white/5 bg-neutral-950/50 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div><div class="text-3xl md:text-4xl font-black text-white"><CountUp client:visible end={7} suffix="+" /></div><p class="text-neutral-400 text-sm mt-2">Moduli</p></div>
        <div><div class="text-3xl md:text-4xl font-black text-white"><CountUp client:visible end={99} suffix="%" /></div><p class="text-neutral-400 text-sm mt-2">Uptime SLA</p></div>
        <div><div class="text-3xl md:text-4xl font-black text-white"><CountUp client:visible end={50} prefix="<" suffix="ms" /></div><p class="text-neutral-400 text-sm mt-2">Risposta API</p></div>
        <div><div class="text-3xl md:text-4xl font-black text-white"><CountUp client:visible end={100} suffix="%" /></div><p class="text-neutral-400 text-sm mt-2">Made in Italy</p></div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES OVERVIEW ===================== -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase text-emerald-400 border border-emerald-500/20 bg-emerald-500/5 mb-4">{t(lang, 'services.badge')}</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white">{t(lang, 'services.title')} <span class="gradient-text">{t(lang, 'services.titleHighlight')}</span></h2>
        <p class="text-neutral-400 mt-4 max-w-2xl mx-auto">{t(lang, 'services.subtitle')}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {[
          { key: 'consulting', icon: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5', color: 'emerald', delay: 0 },
          { key: 'development', icon: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5', color: 'cyan', delay: 3 },
          { key: 'leaf', icon: 'M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L12 12.75 6.429 9.75m11.142 0l4.179 2.25L12 17.25 2.25 12l4.179-2.25', color: 'green', delay: 6 },
          { key: 'support', icon: 'M16.712 4.33a9.027 9.027 0 011.652 1.306c.51.51.944 1.064 1.306 1.652M16.712 4.33l-3.448 4.138m3.448-4.138a9.014 9.014 0 00-9.424 0M19.67 7.288l-4.138 3.448m4.138-3.448a9.014 9.014 0 010 9.424m-1.306 1.652a9.027 9.027 0 01-1.652 1.306m0 0l-3.448-4.138m3.448 4.138a9.014 9.014 0 01-9.424 0m-1.652-1.306a9.027 9.027 0 01-1.306-1.652m0 0l4.138-3.448M4.33 16.712a9.014 9.014 0 010-9.424m4.138 3.448L4.33 7.288', color: 'purple', delay: 9 },
        ].map(({ key, icon, color, delay }) => (
          <div class="relative rounded-2xl p-8 bg-neutral-900/60 border border-white/5 backdrop-blur-sm overflow-hidden group hover:border-emerald-500/20 transition-colors duration-500">
            <BorderBeam client:visible size={250} duration={12} delay={delay} />
            <div class={`w-12 h-12 rounded-xl bg-${color}-500/10 flex items-center justify-center mb-5`}>
              <svg class={`w-6 h-6 text-${color}-400`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={icon} /></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, `services.${key}.title`)}</h3>
            <p class="text-neutral-400 text-sm leading-relaxed">{t(lang, `services.${key}.description`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== LEAF PREVIEW ===================== -->
  <section class="relative py-24 bg-neutral-950/80 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase text-emerald-400 border border-emerald-500/20 bg-emerald-500/5 mb-4">{t(lang, 'leaf.badge')}</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-2">{t(lang, 'leaf.title')} <span class="gradient-text">{t(lang, 'leaf.titleHighlight')}</span> {t(lang, 'leaf.titleEnd')}</h2>
        <p class="text-neutral-400 mt-4 max-w-2xl mx-auto">{t(lang, 'leaf.subtitle')}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
        {[
          { key: 'rotor', color: 'bg-orange-400' },
          { key: 'rootview', color: 'bg-blue-400' },
          { key: 'fastoo', color: 'bg-emerald-400' },
          { key: 'lawrf', color: 'bg-red-400' },
          { key: 'elytra', color: 'bg-purple-400' },
          { key: 'glide', color: 'bg-cyan-400' },
          { key: 'verdanthr', color: 'bg-green-400' },
        ].map(({ key, color }) => (
          <div class="relative group rounded-2xl p-6 bg-neutral-900/50 border border-white/5 hover:border-emerald-500/30 transition-all duration-300 hover:bg-neutral-800/50">
            <div class="flex items-center gap-3 mb-3">
              <div class={`w-3 h-3 rounded-full ${color}`} />
              <h4 class="font-bold text-white">{t(lang, `modules.${key}.name`)}</h4>
              <span class="ml-auto text-xs px-2 py-0.5 rounded-full bg-white/5 text-neutral-400 border border-white/10">{t(lang, `modules.${key}.status`)}</span>
            </div>
            <p class="text-sm text-emerald-400/80 font-medium mb-2">{t(lang, `modules.${key}.tagline`)}</p>
            <p class="text-sm text-neutral-400 leading-relaxed">{t(lang, `modules.${key}.description`)}</p>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href={tp('/leaf')} class="btn-primary px-8 py-4">
          Esplora Tutti i Moduli
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="relative py-24 overflow-hidden border-t border-white/5">
    <div class="absolute inset-0">
      <ConstellationNetwork client:visible className="opacity-20" nodeCount={30} connectionDistance={200} interactive={false} />
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-6">{t(lang, 'cta.title')}</h2>
      <p class="text-lg text-neutral-300 max-w-2xl mx-auto mb-10">{t(lang, 'cta.subtitle')}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={tp('/contact')} class="btn-primary text-base px-8 py-4">{t(lang, 'cta.btn1')}</a>
        <a href={tp('/leaf')} class="btn-secondary text-base px-8 py-4 border-white/10 text-white hover:border-emerald-400/50">{t(lang, 'cta.btn2')}</a>
      </div>
    </div>
  </section>

</BaseLayout>
