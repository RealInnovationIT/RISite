---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, useTranslatedPath } from '@/i18n/utils';
import { WordRotator } from '@/components/react/WordRotator';
import { LiquidGradient } from '@/components/react/LiquidGradient';
import { PerspectiveGrid } from '@/components/react/PerspectiveGrid';
import { ScrollReveal } from '@/components/react/ScrollReveal';
import { ToolChaosGrid } from '@/components/react/ToolChaosGrid';
import { AnimatedDoomLoop } from '@/components/react/AnimatedDoomLoop';
import { CostReveal } from '@/components/react/CostReveal';
import { ConnectionFlow } from '@/components/react/ConnectionFlow';
import { ConstellationNetwork } from '@/components/react/ConstellationNetwork';
import { FlipFadeText } from '@/components/react/FlipFadeText';
import { BorderBeam } from '@/components/react/BorderBeam';
import { ImpactMetrics } from '@/components/react/ImpactMetrics';
import { ChaosCounter } from '@/components/react/ChaosCounter';

const lang = 'it';
const tp = useTranslatedPath(lang);
---

<BaseLayout title="RealInnovation – Soluzioni Software Intelligenti" lang={lang}>

  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-screen w-full flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-[#060a12]">
      <div class="hero-orb-1" />
      <div class="hero-orb-2" />
      <div class="hero-orb-3" />
    </div>
    <LiquidGradient client:load className="opacity-30" />
    <PerspectiveGrid client:visible className="absolute inset-0 opacity-40" gridSize={20} fadeRadius={65} />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,rgba(6,10,18,0.85)_100%)]" />

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-emerald-500/20 bg-emerald-500/5 backdrop-blur-sm mb-8 animate-fade-in">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-sm text-emerald-300 font-medium">{t(lang, 'hero.badge')}</span>
      </div>

      <!-- Main heading -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white mb-2 leading-tight tracking-tight animate-fade-in-up">
        {t(lang, 'hero.title')}
        <span class="gradient-text"> {t(lang, 'hero.titleHighlight')}</span>
      </h1>

      <!-- Rotating pain stats -->
      <div class="mb-8 h-16 md:h-20">
        <WordRotator
          client:load
          words={['6 ABBONAMENTI.', '0 CONNESSIONI.', '8H PERSE / SETTIMANA.', '\u20ac28K BRUCIATI / ANNO.', '1 VIA D\'USCITA.']}
            className="text-3xl md:text-5xl lg:text-6xl font-black text-red-400 tracking-tight"
          interval={2400}
        />
      </div>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-neutral-300 max-w-3xl mx-auto mb-10 leading-relaxed animate-fade-in-up" style="animation-delay: 0.3s">
        {t(lang, 'hero.subtitle')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4 animate-fade-in-up" style="animation-delay: 0.5s">
        <a href={tp('/leaf')} class="btn-primary text-base px-8 py-4">
          {t(lang, 'hero.cta1')}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="#chaos" class="btn-secondary text-base px-8 py-4 border-white/10 text-white hover:border-emerald-400/50">
          {t(lang, 'hero.cta2')}
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
        <span class="text-[10px] uppercase tracking-widest text-neutral-600 font-semibold">Scroll</span>
        <div class="w-px h-8 bg-gradient-to-b from-neutral-600 to-transparent animate-pulse" />
      </div>
    </div>
  </section>

  <!-- ===================== CHAOS WALL ===================== -->
  <section id="chaos" class="relative py-24 md:py-32 border-t border-white/5 overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 30%, rgba(239,68,68,0.06) 0%, transparent 60%);" />
    <div class="relative max-w-6xl mx-auto px-6">

      <ScrollReveal client:visible className="text-center mb-16">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-red-400/60 mb-4">La tua realtà attuale</p>
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-white mb-4 leading-tight">
          Ogni tool che aggiungi<br/><span style="color: #ef4444;">moltiplica il caos.</span>
        </h2>
        <p class="text-neutral-500 text-sm max-w-lg mx-auto">La PMI media usa 6+ strumenti disconnessi. Ognuno aggiunge complessità, uccide il focus e dissangua la produttività.</p>
      </ScrollReveal>

      <!-- Interactive tool chaos visualization -->
      <ScrollReveal client:visible delay={0.3}>
        <ToolChaosGrid
          client:visible
          questionText="E quanti si scambiano dati automaticamente?"
          punchlineText="0"
          captionText="Ogni trasferimento dati è manuale. Ogni fine mese è una maratona di riconciliazione. Ogni decisione si basa sui dati di ieri."
          className="max-w-3xl mx-auto"
        />
      </ScrollReveal>
    </div>
  </section>

  <!-- ===================== COST REALITY ===================== -->
  <section class="relative py-20 md:py-28 border-t border-white/5 overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 50%, rgba(239,68,68,0.03) 0%, transparent 50%);" />
    <div class="max-w-5xl mx-auto px-6">
      <ScrollReveal client:visible className="text-center mb-14">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 mb-4">Il costo reale</p>
        <h2 class="text-2xl md:text-4xl font-black text-white">
          Ecco quanto ti <span style="color: #ef4444;">costa davvero</span> la frammentazione.
        </h2>
      </ScrollReveal>

      <CostReveal
        client:visible
        stats={[
          { value: '6.4', numericValue: 6.4, suffix: '', label: 'strumenti scollegati per PMI, in media', color: '#ffffff' },
          { value: '€28K+', numericValue: 28, prefix: '€', suffix: 'K+', label: 'bruciati in abbonamenti software annui', color: '#ef4444' },
          { value: '8h', numericValue: 8, suffix: 'h', label: 'perse ogni singola settimana in lavoro manuale sui dati', color: '#ffffff' },
        ]}
      />

      <!-- Extra punch -->
      <ScrollReveal client:visible delay={0.6}>
        <div class="relative mt-16 p-8 rounded-2xl border border-red-500/10 bg-red-500/[0.02] text-center overflow-hidden">
          <BorderBeam client:visible colorFrom="#ef4444" colorTo="#f97316" size={300} duration={8} />
          <p class="text-neutral-400 text-sm leading-relaxed max-w-2xl mx-auto">
            Sono <strong class="text-white">€28.000/anno</strong> in abbonamenti, <strong class="text-white">416 ore/anno</strong> in lavoro manuale sui dati, e
            <strong class="text-white">zero visibilità in tempo reale</strong> sui tuoi margini. I tuoi concorrenti che hanno risolto? Conoscono i loro numeri <em>oggi</em>.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- ===================== DOOM LOOP ===================== -->
  <section class="relative py-24 md:py-32 border-t border-white/5 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6">
      <ScrollReveal client:visible className="text-center mb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 mb-4">Il pattern</p>
        <h2 class="text-3xl md:text-5xl font-black text-white leading-tight">
          La trappola della complessità da cui <span class="text-red-400">non esci</span>.
        </h2>
        <p class="text-neutral-500 text-sm mt-4 max-w-lg mx-auto">Ogni azienda con cui parliamo è intrappolata nello stesso ciclo. Più tool, più complessità, meno focus.</p>
      </ScrollReveal>

      <AnimatedDoomLoop
        client:visible
        steps={[
          { label: 'La complessità cresce. Il focus cala.', sublabel: 'Troppi tool, troppi login, troppi processi.' },
          { label: 'Compri un altro software per risolverlo.', sublabel: '"Questa volta collegherà tutto."' },
          { label: 'Più frammentazione. Più caos.', sublabel: 'Costi più alti. Più lavoro manuale. Stesso problema.' },
        ]}
        loopBackLabel="Ripetere. Ogni trimestre. All'infinito."
        bottomText="Aggiungere tool non riduce la complessità."
        bottomHighlight="Connetterli sì."
      />
    </div>
  </section>

  <!-- ===================== THE PIVOT ===================== -->
  <section class="relative py-28 md:py-36 overflow-hidden border-t border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.08)_0%,transparent_60%)]" />
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(16,185,129,1) 1px, transparent 1px), linear-gradient(90deg, rgba(16,185,129,1) 1px, transparent 1px); background-size: 40px 40px;" />

    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <ScrollReveal client:visible>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-500/60 mb-8">Il cambio</p>
      </ScrollReveal>

      <ScrollReveal client:visible delay={0.2}>
        <h2 class="font-black leading-[0.95] mb-8 tracking-tight" style="font-size: clamp(2.8rem, 8vw, 6rem);">
          <span class="text-neutral-600 line-through decoration-neutral-700 decoration-2">Smetti di aggiungere.</span><br/>
          <span class="gradient-text">Inizia a connettere.</span>
        </h2>
      </ScrollReveal>

      <ScrollReveal client:visible delay={0.4}>
        <p class="text-lg md:text-xl text-neutral-400 max-w-xl mx-auto leading-relaxed">
          Non ti serve un altro strumento nel tuo stack.<br/>
          Ti serve <strong class="text-white">il layer che fa lavorare insieme quelli che hai già.</strong>
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- ===================== LEAF REVEAL ===================== -->
  <section class="relative py-28 md:py-36 bg-neutral-950/80 border-t border-white/5 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <ConstellationNetwork
        client:visible
        nodeCount={40}
        connectionDistance={180}
        nodeColor="rgba(16, 185, 129, 0.5)"
        lineColor="rgba(16, 185, 129,"
        interactive={false}
      />
    </div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.06)_0%,transparent_70%)]" />

    <div class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Left: Text content -->
        <div>
          <ScrollReveal client:visible>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400/70 mb-6">Scopri Leaf</p>
          </ScrollReveal>
          <ScrollReveal client:visible delay={0.15}>
            <h2 class="text-3xl md:text-5xl font-black text-white mb-5 leading-tight">
              Un unico layer di integrazione.<br/>
              <span class="gradient-text">Ogni sistema, connesso.</span>
            </h2>
          </ScrollReveal>
          <ScrollReveal client:visible delay={0.3}>
            <p class="text-neutral-400 leading-relaxed mb-8">
              Leaf non sostituisce quello che hai. Lo connette.
              Il tuo ERP, sistema HR, CRM e software contabili — finalmente in comunicazione. In tempo reale. Automaticamente.
            </p>
          </ScrollReveal>

          <!-- Module pills -->
          <ScrollReveal client:visible delay={0.45}>
            <div class="flex flex-wrap gap-2 mb-8">
              {['Rotor', 'RootView', 'FasToo', 'LawRF', 'Elytra', 'Glide', 'VerdantHR'].map((name) => (
                <span class="px-4 py-1.5 rounded-full text-sm font-medium text-emerald-300 border border-emerald-500/20 bg-emerald-500/5 hover:bg-emerald-500/10 hover:border-emerald-400/40 transition-colors cursor-default">
                  {name}
                </span>
              ))}
            </div>
          </ScrollReveal>

          <ScrollReveal client:visible delay={0.6}>
            <a href={tp('/leaf')} class="btn-primary text-base px-8 py-4 inline-flex">
              Esplora Leaf
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </ScrollReveal>
        </div>

        <!-- Right: Animated connection diagram -->
        <ScrollReveal client:visible delay={0.3} direction="right">
          <ConnectionFlow
            client:visible
            centerLabel="Leaf"
            systemNames={['ERP', 'HR', 'CRM', 'Contabilità', 'Fatturazione', 'Analytics']}
          />
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- ===================== BEFORE / AFTER ===================== -->
  <section class="relative py-20 md:py-28 border-t border-white/5 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6">
      <ScrollReveal client:visible className="text-center mb-14">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 mb-4">La differenza</p>
        <h2 class="text-2xl md:text-4xl font-black text-white">
          Lunedì mattina. <span class="gradient-text">Con e senza Leaf.</span>
        </h2>
      </ScrollReveal>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- SENZA -->
        <ScrollReveal client:visible delay={0.1}>
          <div class="relative rounded-2xl p-8 border border-red-500/10 bg-red-500/[0.02] overflow-hidden h-full">
            <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-red-500/40 to-transparent" />
            <div class="flex items-center gap-2 mb-6">
              <div class="w-2 h-2 rounded-full bg-red-500" />
              <span class="text-red-400 text-xs font-bold uppercase tracking-widest">Senza Leaf</span>
            </div>
            <ul class="space-y-4">
              {[
                'Apri Zucchetti. Esporta CSV. Apri Excel.',
                'Incrocia le fatture con la contabilità a mano.',
                'Chiedi all\'HR i dati dei cedolini. Aspetta la mail.',
                'Costruisci il report mensile da 4 fonti diverse.',
                'Scopri un disallineamento di €12K alle 17 di venerdì.',
                'Passi il weekend a sistemarlo.',
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-neutral-400">
                  <svg class="w-4 h-4 mt-0.5 text-red-500/60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-4 border-t border-red-500/10">
              <span class="text-red-400 text-xs font-bold">Tempo speso: ~4 ore</span>
            </div>
          </div>
        </ScrollReveal>

        <!-- CON -->
        <ScrollReveal client:visible delay={0.3}>
          <div class="relative rounded-2xl p-8 border border-emerald-500/15 bg-emerald-500/[0.02] overflow-hidden h-full">
            <BorderBeam client:visible size={250} duration={12} />
            <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-emerald-500/40 to-transparent" />
            <div class="flex items-center gap-2 mb-6">
              <div class="w-2 h-2 rounded-full bg-emerald-500" />
              <span class="text-emerald-400 text-xs font-bold uppercase tracking-widest">Con Leaf</span>
            </div>
            <ul class="space-y-4">
              {[
                'Apri la dashboard. È già tutto lì.',
                'Fatture, cedolini, contabilità — sincronizzati in tempo reale.',
                'Margini per centro di costo? Live. Aggiornati 10 secondi fa.',
                'Report mensile? Auto-generato. Ti aspetta nella inbox.',
                'Disallineamenti? Segnalati automaticamente dal giorno uno.',
                'Lunedì, ore 9:07. Il caffè è ancora caldo.',
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-neutral-300">
                  <svg class="w-4 h-4 mt-0.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-4 border-t border-emerald-500/10">
              <span class="text-emerald-400 text-xs font-bold">Tempo speso: 0 minuti</span>
            </div>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- ===================== WHAT CHANGES ===================== -->
  <section class="relative py-20 md:py-28 border-t border-white/5 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.04)_0%,transparent_60%)]" />
    <div class="relative max-w-5xl mx-auto px-6">
      <ScrollReveal client:visible className="text-center mb-14">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-500/50 mb-4">L'impatto</p>
        <h2 class="text-2xl md:text-4xl font-black text-white mb-4">
          Cosa cambia quando tutto si <span class="gradient-text">connette</span>
        </h2>
      </ScrollReveal>

      <ImpactMetrics
        client:visible
        benefits={[
          {
            icon: 'M13 10V3L4 14h7v7l9-11h-7z',
            title: 'Decisioni basate su dati reali, non sul report del mese scorso.',
            metric: 'Real-time',
            metricLabel: 'visibilità sui margini',
            color: '#10b981',
          },
          {
            icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
            title: 'Il team smette di copiare dati e inizia a fare lavoro vero.',
            metric: '+8h/sett.',
            metricLabel: 'recuperate per persona',
            color: '#06b6d4',
          },
          {
            icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
            title: 'Ogni sincronizzazione garantita. Ogni evento tracciato. Zero perdite.',
            metric: '0 errori',
            metricLabel: 'nella sincronizzazione dati',
            color: '#8b5cf6',
          },
        ]}
      />
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="relative py-24 md:py-32 overflow-hidden border-t border-white/5">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.06)_0%,transparent_70%)]" />
    <div class="absolute inset-0 opacity-[0.015]" style="background-image: linear-gradient(rgba(16,185,129,1) 1px, transparent 1px), linear-gradient(90deg, rgba(16,185,129,1) 1px, transparent 1px); background-size: 60px 60px;" />

    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <ScrollReveal client:visible>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-500/50 mb-6">Pronto?</p>
        <h2 class="text-3xl md:text-5xl font-black text-white mb-6">{t(lang, 'cta.title')}</h2>
        <p class="text-lg text-neutral-300 max-w-2xl mx-auto mb-10">{t(lang, 'cta.subtitle')}</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href={tp('/contact')} class="btn-primary text-base px-8 py-4">{t(lang, 'cta.btn1')}</a>
          <a href={tp('/leaf')} class="btn-secondary text-base px-8 py-4 border-white/10 text-white hover:border-emerald-400/50">{t(lang, 'cta.btn2')}</a>
        </div>
      </ScrollReveal>
    </div>
  </section>

</BaseLayout>