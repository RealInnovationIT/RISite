---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, useTranslatedPath } from '@/i18n/utils';
import { ConstellationNetwork } from '@/components/react/ConstellationNetwork';
import { BorderBeam } from '@/components/react/BorderBeam';

const lang = 'it';
const tp = useTranslatedPath(lang);

const services = [
  { key: 'consulting',  icon: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5', color: 'emerald', num: '01' },
  { key: 'development', icon: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5', color: 'cyan', num: '02' },
  { key: 'leaf',        icon: 'M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L12 12.75 6.429 9.75m11.142 0l4.179 2.25L12 17.25 2.25 12l4.179-2.25', color: 'green', num: '03' },
  { key: 'support',     icon: 'M16.712 4.33a9.027 9.027 0 011.652 1.306c.51.51.944 1.064 1.306 1.652M16.712 4.33l-3.448 4.138m3.448-4.138a9.014 9.014 0 00-9.424 0M19.67 7.288l-4.138 3.448m4.138-3.448a9.014 9.014 0 010 9.424m-1.306 1.652a9.027 9.027 0 01-1.652 1.306m0 0l-3.448-4.138m3.448 4.138a9.014 9.014 0 01-9.424 0m-1.652-1.306a9.027 9.027 0 01-1.306-1.652m0 0l4.138-3.448M4.33 16.712a9.014 9.014 0 010-9.424m4.138 3.448L4.33 7.288', color: 'purple', num: '04' },
];
---

<BaseLayout title="Servizi – RealInnovation" lang={lang}>

  <!-- ===================== HERO ===================== -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[#0a0a0f]" />
    <ConstellationNetwork client:load className="opacity-25" nodeCount={35} connectionDistance={150} />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#0a0a0f]" />

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase text-emerald-400 border border-emerald-500/20 bg-emerald-500/5 mb-6">{t(lang, 'services.badge')}</span>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white leading-tight tracking-tight">
        {t(lang, 'services.title')} <span class="gradient-text">{t(lang, 'services.titleHighlight')}</span>
      </h1>
      <p class="text-lg md:text-xl text-neutral-300 max-w-3xl mx-auto mt-6 leading-relaxed">{t(lang, 'services.subtitle')}</p>
    </div>
  </section>

  <!-- ===================== SERVICES GRID ===================== -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-6">
        {services.map(({ key, icon, color, num }) => (
          <div class="relative rounded-2xl bg-neutral-900/50 border border-white/5 overflow-hidden hover:border-emerald-500/20 transition-colors duration-300 group p-8">
            <BorderBeam client:visible size={300} duration={15} delay={parseInt(num) * 3} />

            <!-- Header -->
            <div class="flex items-start gap-5 mb-5">
              <span class="text-4xl font-black text-white/5 group-hover:text-emerald-500/10 transition-colors leading-none mt-1">{num}</span>
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-3">
                  <div class={`w-10 h-10 rounded-lg bg-${color}-500/10 flex items-center justify-center flex-shrink-0`}>
                    <svg class={`w-5 h-5 text-${color}-400`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={icon} /></svg>
                  </div>
                  <h3 class="text-xl font-bold text-white">{t(lang, `services.${key}.title`)}</h3>
                </div>
                <p class="text-neutral-400 leading-relaxed text-sm">{t(lang, `services.${key}.description`)}</p>
              </div>
            </div>

            <!-- Divider -->
            <div class="border-t border-white/5 my-5" />

            <!-- Detail (always visible) -->
            <div class="grid grid-cols-2 gap-5">
              <div>
                <h4 class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2">Cosa Risolviamo</h4>
                <p class="text-neutral-300 leading-relaxed text-sm">{t(lang, `services.${key}.solves`)}</p>
              </div>
              <div>
                <h4 class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2">Come Lavoriamo</h4>
                <p class="text-neutral-300 leading-relaxed text-sm">{t(lang, `services.${key}.how`)}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="py-24 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-6">{t(lang, 'cta.title')}</h2>
      <p class="text-lg text-neutral-300 max-w-2xl mx-auto mb-10">{t(lang, 'cta.subtitle')}</p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={tp('/contact')} class="btn-primary text-base px-8 py-4">{t(lang, 'cta.btn1')}</a>
        <a href={tp('/leaf')} class="btn-secondary text-base px-8 py-4 border-white/10 text-white hover:border-emerald-400/50">{t(lang, 'cta.btn2')}</a>
      </div>
    </div>
  </section>

</BaseLayout>
