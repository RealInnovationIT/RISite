---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, useTranslatedPath } from '@/i18n/utils';
import { ConstellationNetwork } from '@/components/react/ConstellationNetwork';
import { BorderBeam } from '@/components/react/BorderBeam';
import { CountUp } from '@/components/react/CountUp';

const lang = 'it';
const tp = useTranslatedPath(lang);
---

<BaseLayout title="Chi Siamo – RealInnovation" lang={lang}>

  <!-- ===================== HERO ===================== -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[#0a0a0f]" />
    <ConstellationNetwork client:load className="opacity-30" nodeCount={40} connectionDistance={160} />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#0a0a0f]" />

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase text-emerald-400 border border-emerald-500/20 bg-emerald-500/5 mb-6">{t(lang, 'about.badge')}</span>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white leading-tight tracking-tight">
        {t(lang, 'about.title')}
        <span class="gradient-text"> {t(lang, 'about.titleHighlight')}</span>
        <br />{t(lang, 'about.titleEnd')}
      </h1>
      <p class="text-lg md:text-xl text-neutral-300 max-w-3xl mx-auto mt-6 leading-relaxed">{t(lang, 'about.subtitle')}</p>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="relative py-16 border-y border-white/5 bg-neutral-950/50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div><div class="text-4xl md:text-5xl font-black text-white"><CountUp client:visible end={7} suffix="+" /></div><p class="text-neutral-400 text-sm mt-2">{t(lang, 'about.stats.modules')}</p></div>
        <div><div class="text-4xl md:text-5xl font-black text-emerald-400"><CountUp client:visible end={99.9} decimals={1} suffix="%" /></div><p class="text-neutral-400 text-sm mt-2">{t(lang, 'about.stats.uptime')}</p></div>
        <div><div class="text-4xl md:text-5xl font-black text-white"><CountUp client:visible end={50} prefix="<" suffix="ms" /></div><p class="text-neutral-400 text-sm mt-2">{t(lang, 'about.stats.response')}</p></div>
        <div><div class="text-4xl md:text-5xl font-black text-emerald-400"><CountUp client:visible end={100} suffix="%" /></div><p class="text-neutral-400 text-sm mt-2">{t(lang, 'about.stats.italy')}</p></div>
      </div>
    </div>
  </section>

  <!-- ===================== MISSION & VISION ===================== -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="relative rounded-2xl p-10 bg-gradient-to-br from-emerald-500/5 to-transparent border border-emerald-500/10 overflow-hidden">
          <BorderBeam client:visible size={300} duration={15} />
          <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" /></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">{t(lang, 'about.mission.title')}</h3>
          <p class="text-neutral-300 leading-relaxed text-lg">{t(lang, 'about.mission.description')}</p>
        </div>

        <div class="relative rounded-2xl p-10 bg-gradient-to-br from-purple-500/5 to-transparent border border-purple-500/10 overflow-hidden">
          <BorderBeam client:visible size={300} duration={15} delay={5} />
          <div class="w-14 h-14 rounded-2xl bg-purple-500/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-4">{t(lang, 'about.vision.title')}</h3>
          <p class="text-neutral-300 leading-relaxed text-lg">{t(lang, 'about.vision.description')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHY US ===================== -->
  <section class="py-24 bg-neutral-950/80 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-white">{t(lang, 'about.whyUs.title')}</h2>
        <p class="text-neutral-400 mt-4 max-w-2xl mx-auto">{t(lang, 'about.whyUs.subtitle')}</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {[
          { key: 'engineering', icon: 'M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085', color: 'emerald' },
          { key: 'domain', icon: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25', color: 'blue' },
          { key: 'speed', icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z', color: 'amber' },
          { key: 'italy', icon: 'M9 6.75V15m0-8.25a2.25 2.25 0 112.25 2.25H9m0-4.5a2.25 2.25 0 10-2.25 2.25H9m0 0V15m0 0h2.25A2.25 2.25 0 0013.5 12.75v0A2.25 2.25 0 0011.25 10.5H9m0 4.5v5.25m0 0h3.75M9 20.25H5.625A2.625 2.625 0 013 17.625V4.875A2.625 2.625 0 015.625 2.25h12.75A2.625 2.625 0 0121 4.875v12.75A2.625 2.625 0 0118.375 20.25H9', color: 'red' },
        ].map(({ key, icon, color }) => (
          <div class="rounded-2xl p-8 bg-neutral-900/50 border border-white/5 hover:border-emerald-500/20 transition-colors">
            <div class={`w-12 h-12 rounded-xl bg-${color}-500/10 flex items-center justify-center mb-5`}>
              <svg class={`w-6 h-6 text-${color}-400`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={icon} /></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, `about.whyUs.${key}.title`)}</h3>
            <p class="text-neutral-400 leading-relaxed">{t(lang, `about.whyUs.${key}.description`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== VALUES ===================== -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16"><h2 class="text-3xl md:text-5xl font-bold text-white">{t(lang, 'about.values.title')}</h2></div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {[
          { key: 'innovation', icon: '💡' },
          { key: 'reliability', icon: '🛡️' },
          { key: 'simplicity', icon: '✨' },
          { key: 'professionalism', icon: '🎯' },
          { key: 'madeInItaly', icon: '🇮🇹' },
          { key: 'security', icon: '🔒' },
        ].map(({ key, icon }) => (
          <div class="rounded-2xl p-6 bg-neutral-900/30 border border-white/5 hover:border-emerald-500/15 transition-colors text-center">
            <div class="text-3xl mb-4">{icon}</div>
            <h4 class="text-lg font-bold text-white mb-2">{t(lang, `about.values.${key}`)}</h4>
            <p class="text-sm text-neutral-400 leading-relaxed">{t(lang, `about.values.${key}Desc`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== TECH STACK ===================== -->
  <section class="py-24 bg-neutral-950/80 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-white">{t(lang, 'about.techStack.title')}</h2>
        <p class="text-neutral-400 mt-3">{t(lang, 'about.techStack.subtitle')}</p>
      </div>
      <div class="flex flex-wrap justify-center gap-4">
        {['C# / .NET 10', 'ASP.NET Core', 'PostgreSQL', 'Kubernetes', 'Docker', 'RabbitMQ', 'React', 'Python / Odoo', 'FastAPI', 'OpenTelemetry'].map((tech) => (
          <span class="px-5 py-2.5 rounded-xl bg-neutral-800/50 border border-white/5 text-sm text-neutral-300 font-mono hover:border-emerald-500/30 hover:text-emerald-300 transition-colors">{tech}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="py-24 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-6">{t(lang, 'cta.title')}</h2>
      <p class="text-lg text-neutral-300 max-w-2xl mx-auto mb-10">{t(lang, 'cta.subtitle')}</p>
      <a href={tp('/contact')} class="btn-primary text-base px-8 py-4">{t(lang, 'cta.btn1')}</a>
    </div>
  </section>

</BaseLayout>
