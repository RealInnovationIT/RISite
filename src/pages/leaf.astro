---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, useTranslatedPath } from '@/i18n/utils';
import { ConstellationNetwork } from '@/components/react/ConstellationNetwork';
import { EcosystemMap } from '@/components/react/EcosystemMap';
import { BorderBeam } from '@/components/react/BorderBeam';

const lang = 'en';
const tp = useTranslatedPath(lang);

const modules = [
  {
    id: 'rotor',
    name: t(lang, 'modules.rotor.name'),
    tagline: t(lang, 'modules.rotor.tagline'),
    description: t(lang, 'modules.rotor.description'),
    status: 'Beta' as const,
    icon: '⚙️',
    color: '#f97316',
    details: {
      solves: t(lang, 'modules.rotor.solves'),
      howItWorks: t(lang, 'modules.rotor.howItWorks'),
      useCase: t(lang, 'modules.rotor.useCase'),
    },
  },
  {
    id: 'rootview',
    name: t(lang, 'modules.rootview.name'),
    tagline: t(lang, 'modules.rootview.tagline'),
    description: t(lang, 'modules.rootview.description'),
    status: 'Planned' as const,
    icon: '📊',
    color: '#3b82f6',
    details: {
      solves: t(lang, 'modules.rootview.solves'),
      howItWorks: t(lang, 'modules.rootview.howItWorks'),
      useCase: t(lang, 'modules.rootview.useCase'),
    },
  },
  {
    id: 'fastoo',
    name: t(lang, 'modules.fastoo.name'),
    tagline: t(lang, 'modules.fastoo.tagline'),
    description: t(lang, 'modules.fastoo.description'),
    status: 'In Development' as const,
    icon: '💰',
    color: '#10b981',
    details: {
      solves: t(lang, 'modules.fastoo.solves'),
      howItWorks: t(lang, 'modules.fastoo.howItWorks'),
      useCase: t(lang, 'modules.fastoo.useCase'),
    },
  },
  {
    id: 'lawrf',
    name: t(lang, 'modules.lawrf.name'),
    tagline: t(lang, 'modules.lawrf.tagline'),
    description: t(lang, 'modules.lawrf.description'),
    status: 'In Development' as const,
    icon: '⚖️',
    color: '#ef4444',
    details: {
      solves: t(lang, 'modules.lawrf.solves'),
      howItWorks: t(lang, 'modules.lawrf.howItWorks'),
      useCase: t(lang, 'modules.lawrf.useCase'),
    },
  },
  {
    id: 'elytra',
    name: t(lang, 'modules.elytra.name'),
    tagline: t(lang, 'modules.elytra.tagline'),
    description: t(lang, 'modules.elytra.description'),
    status: 'Planned' as const,
    icon: '🤝',
    color: '#a855f7',
    details: {
      solves: t(lang, 'modules.elytra.solves'),
      howItWorks: t(lang, 'modules.elytra.howItWorks'),
      useCase: t(lang, 'modules.elytra.useCase'),
    },
  },
  {
    id: 'glide',
    name: t(lang, 'modules.glide.name'),
    tagline: t(lang, 'modules.glide.tagline'),
    description: t(lang, 'modules.glide.description'),
    status: 'Planned' as const,
    icon: '🔄',
    color: '#06b6d4',
    details: {
      solves: t(lang, 'modules.glide.solves'),
      howItWorks: t(lang, 'modules.glide.howItWorks'),
      useCase: t(lang, 'modules.glide.useCase'),
    },
  },
  {
    id: 'verdanthr',
    name: t(lang, 'modules.verdanthr.name'),
    tagline: t(lang, 'modules.verdanthr.tagline'),
    description: t(lang, 'modules.verdanthr.description'),
    status: 'Planned' as const,
    icon: '👥',
    color: '#22c55e',
    details: {
      solves: t(lang, 'modules.verdanthr.solves'),
      howItWorks: t(lang, 'modules.verdanthr.howItWorks'),
      useCase: t(lang, 'modules.verdanthr.useCase'),
    },
  },
];
---

<BaseLayout title="Leaf – Modular Business Ecosystem" lang={lang}>

  <!-- ===================== HERO ===================== -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[#0a0a0f]" />
    <ConstellationNetwork client:load className="opacity-30" nodeCount={50} connectionDistance={140} nodeColor="rgba(16,185,129,0.6)" lineColor="rgba(16,185,129,0.15)" />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#0a0a0f]" />

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase text-emerald-400 border border-emerald-500/20 bg-emerald-500/5 mb-6">
        {t(lang, 'leaf.badge')}
      </span>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white leading-tight tracking-tight">
        {t(lang, 'leaf.title')} <span class="gradient-text">{t(lang, 'leaf.titleHighlight')}</span>
        <br />{t(lang, 'leaf.titleEnd')}
      </h1>
      <p class="text-lg md:text-xl text-neutral-300 max-w-3xl mx-auto mt-6 leading-relaxed">
        {t(lang, 'leaf.subtitle')}
      </p>
    </div>
  </section>

  <!-- ===================== WHAT IS LEAF / BENEFITS ===================== -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <!-- Left: headline -->
        <div>
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-emerald-400 bg-emerald-400/10 px-3 py-1.5 rounded-full mb-6">
            {t(lang, 'leaf.benefits.tag')}
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-white leading-tight mb-6">
            {t(lang, 'leaf.benefits.headline')}<br />
            <span class="gradient-text">{t(lang, 'leaf.benefits.headlineHighlight')}</span>
          </h2>
          <p class="text-neutral-400 text-lg leading-relaxed">
            {t(lang, 'leaf.whatIs.description')}
          </p>
        </div>
        <!-- Right: 2x2 stat cards -->
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl p-6 border border-emerald-500/10 bg-emerald-500/5">
            <div class="text-3xl font-black text-emerald-400 mb-1">{t(lang, 'leaf.benefits.stat1')}</div>
            <div class="text-sm font-bold text-white mb-2">{t(lang, 'leaf.benefits.stat1Label')}</div>
            <p class="text-xs text-neutral-400 leading-relaxed">{t(lang, 'leaf.benefits.stat1Desc')}</p>
          </div>
          <div class="rounded-2xl p-6 border border-blue-500/10 bg-blue-500/5">
            <div class="text-3xl font-black text-blue-400 mb-1">{t(lang, 'leaf.benefits.stat2')}</div>
            <div class="text-sm font-bold text-white mb-2">{t(lang, 'leaf.benefits.stat2Label')}</div>
            <p class="text-xs text-neutral-400 leading-relaxed">{t(lang, 'leaf.benefits.stat2Desc')}</p>
          </div>
          <div class="rounded-2xl p-6 border border-amber-500/10 bg-amber-500/5">
            <div class="text-3xl font-black text-amber-400 mb-1">{t(lang, 'leaf.benefits.stat3')}</div>
            <div class="text-sm font-bold text-white mb-2">{t(lang, 'leaf.benefits.stat3Label')}</div>
            <p class="text-xs text-neutral-400 leading-relaxed">{t(lang, 'leaf.benefits.stat3Desc')}</p>
          </div>
          <div class="rounded-2xl p-6 border border-purple-500/10 bg-purple-500/5">
            <div class="text-3xl font-black text-purple-400 mb-1">{t(lang, 'leaf.benefits.stat4')}</div>
            <div class="text-sm font-bold text-white mb-2">{t(lang, 'leaf.benefits.stat4Label')}</div>
            <p class="text-xs text-neutral-400 leading-relaxed">{t(lang, 'leaf.benefits.stat4Desc')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== ECOSYSTEM MAP ===================== -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">
          The <span class="gradient-text">Ecosystem</span>
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto">Click any module to explore what it does, what it solves, and how it works. Every module connects to the others through our event-driven architecture.</p>
      </div>

      <EcosystemMap
        client:visible
        modules={modules}
        centerLabel="Leaf"
        centerSublabel="Event-Driven Core"
      />
    </div>
  </section>

  <!-- ===================== COMPARISON ===================== -->
  <section class="py-24 bg-neutral-950/80 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-4">
          {t(lang, 'leaf.comparison.title')}
          <span class="gradient-text"> {t(lang, 'leaf.comparison.titleHighlight')}</span>
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto">{t(lang, 'leaf.comparison.subtitle')}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Without Leaf -->
        <div class="rounded-2xl border border-red-500/15 overflow-hidden">
          <div class="px-6 py-4 bg-red-500/8 border-b border-red-500/15">
            <h3 class="font-bold text-red-400 flex items-center gap-2">
              <span>⚠</span> {t(lang, 'leaf.comparison.withoutTitle')}
            </h3>
          </div>
          <div class="divide-y divide-white/5">
            {[
              lang === 'en' ? '5–8 hours/week on manual reconciliation'    : '5–8 ore/settimana di riconciliazione manuale',
              lang === 'en' ? '4+ disconnected tools to manage'             : '4+ strumenti disconnessi da gestire',
              lang === 'en' ? 'Reports only ready at end of month'          : 'Report pronti solo a fine mese',
              lang === 'en' ? 'Constant data sync failures'                 : 'Errori continui di sincronizzazione dati',
              lang === 'en' ? 'Data silos per department'                   : 'Silos di dati per reparto',
              lang === 'en' ? 'Year-end reconciliation panic'               : 'Panico da riconciliazione di fine anno',
            ].map((item, i) => (
              <div class="px-6 py-4 flex items-center gap-3">
                <span class="text-red-400 text-lg flex-shrink-0">✕</span>
                <span class="text-neutral-400 text-sm">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- With Leaf -->
        <div class="rounded-2xl border border-emerald-500/20 overflow-hidden">
          <div class="px-6 py-4 bg-emerald-500/8 border-b border-emerald-500/20">
            <h3 class="font-bold text-emerald-400 flex items-center gap-2">
              <span>✓</span> {t(lang, 'leaf.comparison.withTitle')}
            </h3>
          </div>
          <div class="divide-y divide-white/5">
            {[
              lang === 'en' ? 'Automated sync — zero manual work'          : 'Sincronizzazione automatica — zero lavoro manuale',
              lang === 'en' ? '1 unified workspace for everything'          : '1 workspace unificato per tutto',
              lang === 'en' ? 'Live dashboards and KPIs, any time'         : 'Dashboard e KPI live, in qualsiasi momento',
              lang === 'en' ? 'Event-driven reliability, self-healing'      : 'Affidabilità event-driven, auto-ripristino',
              lang === 'en' ? 'All departments connected and in sync'       : 'Tutti i reparti connessi e sincronizzati',
              lang === 'en' ? 'Continuous data consistency, always'         : 'Dati sempre coerenti, senza sorprese',
            ].map((item, i) => (
              <div class="px-6 py-4 flex items-center gap-3">
                <span class="text-emerald-400 text-lg flex-shrink-0">✓</span>
                <span class="text-neutral-300 text-sm">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="py-24 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-6">{t(lang, 'cta.title')}</h2>
      <p class="text-lg text-neutral-300 max-w-2xl mx-auto mb-10">{t(lang, 'cta.subtitle')}</p>
      <a href={tp('/contact')} class="btn-primary text-base px-8 py-4">{t(lang, 'cta.btn1')}</a>
    </div>
  </section>

</BaseLayout>
