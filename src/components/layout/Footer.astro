---
import { t, useTranslatedPath } from '@/i18n/utils';

interface Props {
  lang: 'en' | 'it';
}

const { lang } = Astro.props;
const tp = useTranslatedPath(lang);

const modules = ['Rotor', 'RootView', 'FasToo', 'LawRF', 'Elytra', 'Glide', 'VerdantHR'];
---

<footer class="border-t" style="border-color: var(--border-color); background: var(--bg-secondary)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href={tp('/')} class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-accent-500 flex items-center justify-center font-bold text-white text-sm">
            RI
          </div>
          <span class="font-bold text-lg" style="color: var(--text-primary)">
            Real<span class="gradient-text">Innovation</span>
          </span>
        </a>
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary)">
          {t(lang, 'footer.description')}
        </p>
        <div class="flex gap-3 mt-4">
          <a href="https://github.com/RealInnovationIT" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg transition-all hover:bg-brand-400/10 hover:text-brand-400" style="color: var(--text-muted)" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/realinnovation" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg transition-all hover:bg-brand-400/10 hover:text-brand-400" style="color: var(--text-muted)" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider mb-4" style="color: var(--text-muted)">{t(lang, 'footer.navigation')}</h3>
        <ul class="space-y-2">
          <li><a href={tp('/')} class="text-sm transition-colors hover:text-brand-400" style="color: var(--text-secondary)">{t(lang, 'nav.home')}</a></li>
          <li><a href={tp('/about')} class="text-sm transition-colors hover:text-brand-400" style="color: var(--text-secondary)">{t(lang, 'nav.about')}</a></li>
          <li><a href={tp('/services')} class="text-sm transition-colors hover:text-brand-400" style="color: var(--text-secondary)">{t(lang, 'nav.services')}</a></li>
          <li><a href={tp('/pricing')} class="text-sm transition-colors hover:text-brand-400" style="color: var(--text-secondary)">{t(lang, 'nav.pricing')}</a></li>
          <li><a href={tp('/contact')} class="text-sm transition-colors hover:text-brand-400" style="color: var(--text-secondary)">{t(lang, 'nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Products -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider mb-4" style="color: var(--text-muted)">{t(lang, 'footer.products')}</h3>
        <ul class="space-y-2">
          {modules.map(m => (
            <li><a href={tp('/leaf')} class="text-sm transition-colors hover:text-brand-400" style="color: var(--text-secondary)">{m}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider mb-4" style="color: var(--text-muted)">{t(lang, 'footer.connect')}</h3>
        <ul class="space-y-3">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:info@realinnovation.it" class="text-sm transition-colors hover:text-brand-400" style="color: var(--text-secondary)">info@realinnovation.it</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-sm" style="color: var(--text-secondary)">{t(lang, 'contact.info.location')}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t flex flex-col sm:flex-row justify-between items-center gap-4" style="border-color: var(--border-color)">
      <p class="text-xs" style="color: var(--text-muted)">{t(lang, 'footer.copyright')}</p>
      <p class="text-xs" style="color: var(--text-muted)">{t(lang, 'footer.builtWith')}</p>
    </div>
  </div>
</footer>
